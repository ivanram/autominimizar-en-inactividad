<Window x:Class="AutoMinimizarInactividad.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes — Autominimizar en inactividad"
        Width="480" Height="620"
        MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextElement.FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiempo de inactividad -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Tiempo de inactividad" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" />
            <DockPanel>
                <TextBlock Text="Minimizar tras" VerticalAlignment="Center" />
                <TextBox x:Name="SecondsTextBox" Width="50" Margin="8,0" VerticalAlignment="Center" TextAlignment="Center"
                         PreviewTextInput="SecondsTextBox_PreviewTextInput"
                         TextChanged="SecondsTextBox_TextChanged" />
                <TextBlock Text="segundos de inactividad" VerticalAlignment="Center" DockPanel.Dock="Right" />
            </DockPanel>
            <Slider x:Name="SecondsSlider" Minimum="5" Maximum="300"
                    Margin="0,10,0,0" ValueChanged="SecondsSlider_ValueChanged" />
        </StackPanel>

        <!-- Ajustes adicionales -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Ajustes adicionales" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" />
            <CheckBox x:Name="StartWithWindowsCheckBox" Content="Iniciar automáticamente con Windows" Margin="0,4" />
            <CheckBox x:Name="ScreensaverCheckBox" Content="Abrir también el salvapantallas de Windows" Margin="0,4" />
        </StackPanel>

        <!-- Lista de apps -->
        <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock Text="Aplicaciones a minimizar" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
            <Button x:Name="RefreshButton" Content="Actualizar lista" DockPanel.Dock="Right"
                    Click="RefreshButton_Click" />
        </DockPanel>

        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="3">
            <ListBox x:Name="AppsList" HorizontalContentAlignment="Stretch"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="Row" Margin="8,6" ToolTip="{Binding TooltipText}" IsEnabled="{Binding IsEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Checked="AppCheckBox_CheckedChanged" Unchecked="AppCheckBox_CheckedChanged" />
                            <Image Grid.Column="1" Width="20" Height="20" Margin="0,0,8,0" Source="{Binding Icon}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SubtitleText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Botones -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancelar" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Content="Guardar" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
